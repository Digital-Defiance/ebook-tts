{
  "title": "ebook-tts distribution manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "manifest_version", "kind", "plan_sha256", "run_id",
    "run_manifest_sha256", "artifact_state_sha256", "book", "quality", "tracks"
  ],
  "properties": {
    "manifest_version": {"const": 1},
    "kind": {"const": "ebook-tts-distribution"},
    "plan_sha256": {"$ref": "#/$defs/sha256"},
    "run_id": {"$ref": "#/$defs/sha256"},
    "run_manifest_sha256": {"$ref": "#/$defs/sha256"},
    "artifact_state_sha256": {"$ref": "#/$defs/sha256"},
    "book": {"type": "object", "required": ["title", "authors"]},
    "quality": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["qa_id", "status", "run_manifest_sha256"],
          "properties": {
            "qa_id": {"$ref": "#/$defs/sha256"},
            "status": {"enum": ["pass", "warn", "fail"]},
            "run_manifest_sha256": {"$ref": "#/$defs/sha256"}
          }
        }
      ]
    },
    "tracks": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/track"}}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "track": {
      "type": "object",
      "additionalProperties": false,
      "required": ["track_number", "title", "file", "sha256", "duration_seconds", "bytes", "assembly_sha256"],
      "properties": {
        "track_number": {"type": "integer", "minimum": 1},
        "title": {"type": "string", "minLength": 1},
        "file": {"type": "string", "pattern": "^audio/[0-9]{3}_[A-Za-z0-9][A-Za-z0-9_-]*\\.mp3$"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "duration_seconds": {"type": "number", "exclusiveMinimum": 0},
        "bytes": {"type": "integer", "minimum": 1},
        "assembly_sha256": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/sha256"}]}
      }
    }
  }
}
