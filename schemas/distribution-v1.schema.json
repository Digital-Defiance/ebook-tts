{
  "title": "ebook-tts distribution manifest v1",
  "type": "object",
  "required": ["manifest_version", "kind", "plan_sha256", "run_id", "book", "tracks"],
  "properties": {
    "manifest_version": {"const": 1},
    "kind": {"const": "ebook-tts-distribution"},
    "plan_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "run_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "book": {"type": "object", "required": ["title", "authors"]},
    "tracks": {"type": "array", "minItems": 1}
  }
}
